# Gemini AI (required for AI analysis features)
GEMINI_API_KEY=your_gemini_api_key_here

# Bhashini (optional — voice transcription + Hindi translation)
BHASHINI_API_KEY=

# Database (SQLite — file-based, no setup needed)
DATABASE_URL="file:./dev.db"

# Server
NODE_ENV=development
PORT=3000

# Auth (change this to a secure random string in production)
JWT_SECRET=change-this-to-a-secure-random-string
AUTH_BYPASS=false
